# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# Ports Configuration
# Backend API server port (internal: 8080, external: configurable)
NOFX_BACKEND_PORT=8080

# Frontend web interface port (Nginx listens on port 80 internally)
NOFX_FRONTEND_PORT=3000

# Timezone Setting
# System timezone for container time synchronization
NOFX_TIMEZONE=Asia/Shanghai

# Copy trading order cache (default: ./data/copy-trading)
# COPY_TRADING_CACHE_DIR=./data/copy-trading

# 币安跟单 BAPI 根地址（Docker 内若 502/地区限制，可配代理或镜像域名）
# BINANCE_BAPI_BASE_URL=https://www.binance.com
# HTTP_PROXY=http://host.docker.internal:7890

# Docker 构建 Go 依赖（国内默认 goproxy.cn；海外可改为 https://proxy.golang.org,direct）
# GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
# GOSUMDB=sum.golang.google.cn

# Docker Hub 拉取 403 Forbidden 时，取消下面注释改用国内镜像加速（DaoCloud 示例）
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# ALPINE_IMAGE=docker.m.daocloud.io/library/alpine:latest
# GOLANG_IMAGE=docker.m.daocloud.io/library/golang:1.25-alpine

# 部署加速：使用预构建 TA-Lib 基础镜像（需先构建一次 ta-lib-base）
# TA_LIB_VERSION=0.4.0
# NOFX_BACKEND_BUILD_TARGET=fast
# TA_LIB_BASE_IMAGE=local/nofx-ta-lib-base:0.4.0
#
# 从 GHCR 拉取已构建镜像（设置后 ./start.sh update 将 pull 而非本地 build）
# NOFX_BACKEND_IMAGE=ghcr.io/<owner>/<repo>/nofx-backend:latest
# NOFX_FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/nofx-frontend:latest

