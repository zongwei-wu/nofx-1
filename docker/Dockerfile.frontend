# docker/frontend/Dockerfile

# ═══════════════════════════════════════════════════════════════
# NOFX Frontend Dockerfile (Node Build → Nginx Runtime)
# Versions extracted as ARGs for consistency
# ═══════════════════════════════════════════════════════════════

# 国内 Docker Hub 403 时可在 .env 设置镜像，例如:
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
ARG NODE_IMAGE=node:20-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

# ──────────────────────────────────────────────────────────────
# Build Stage: 用户前台 (web)
# ──────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS builder-web
WORKDIR /build/web

COPY web/package*.json ./
RUN npm ci

COPY web/ ./
RUN NODE_OPTIONS="--max-old-space-size=512" npm run build -- --emptyOutDir

# ──────────────────────────────────────────────────────────────
# Build Stage: 管理后台 (admin-web)
# ──────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS builder-admin
WORKDIR /build/admin

COPY admin-web/package*.json ./
RUN npm install

COPY admin-web/ ./
RUN NODE_OPTIONS="--max-old-space-size=512" npm run build

# ──────────────────────────────────────────────────────────────
# Runtime Stage (Nginx)
# ──────────────────────────────────────────────────────────────
FROM ${NGINX_IMAGE}

COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder-web /build/web/dist /usr/share/nginx/html
COPY --from=builder-admin /build/admin/dist /usr/share/nginx/html/admin

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
