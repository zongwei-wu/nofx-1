## 5. 策略引擎设计

### 5.1 策略配置模型

```go
type StrategyConfig struct {
    ID          string            `json:"id"`
    UserID      string            `json:"user_id"`
    Name        string            `json:"name"`
    Symbol      string            `json:"symbol"`       // "ETHUSDT" 或 "*" 全币种
    Timeframe   string            `json:"timeframe"`    // "1m"/"5m"/"15m"/"1h"/"4h"
    Direction   string            `json:"direction"`    // "long_only"/"short_only"/"both"
    
    // 入场条件：组内 AND，组间 OR
    EntryConditions []ConditionGroup `json:"entry_conditions"`
    
    // 加仓条件（可选）
    AddPositionConditions []ConditionGroup `json:"add_position_conditions,omitempty"`
    
    // 离场条件（可选，优先级高于止盈止损）
    ExitConditions []ConditionGroup `json:"exit_conditions,omitempty"`
    
    // 止盈止损
    ExitRules ExitRules `json:"exit_rules"`
    
    // 风控
    Risk RiskConfig `json:"risk"`
}

type ConditionGroup []Condition

type Condition struct {
    Indicator string  `json:"indicator"` // "MACD"/"RSI7"/"EMA20"/"RSI14"/...
    Operator  string  `json:"operator"`  // ">" / "<" / "cross_above" / "cross_below" / ">=" / "<="
    Value     float64 `json:"value"`
    Timeframe string  `json:"timeframe,omitempty"` // 多时间框架支持
}

type ExitRules struct {
    TakeProfitPct    float64 `json:"take_profit_pct"`
    StopLossPct      float64 `json:"stop_loss_pct"`
    TrailingStop     bool    `json:"trailing_stop"`
    TrailingDistPct  float64 `json:"trailing_dist_pct,omitempty"`
    TimeStop         string  `json:"time_stop,omitempty"` // "4h" 持仓超时平仓
}

type RiskConfig struct {
    MaxPositions   int     `json:"max_positions"`
    Leverage       int     `json:"leverage"`
    RiskPerTrade   float64 `json:"risk_per_trade"`   // 单笔风险占账户比例
    MaxDrawdownPct float64 `json:"max_drawdown_pct"` // 最大回撤后暂停策略
}
```

### 5.2 信号生成流程

```
每个 tick（K线闭合时）:
  
  1. 拉取最新 K 线
     market.GetKlines(symbol, timeframe, 200)
  
  2. 提取策略需要的指标列表
     indicators := extractIndicators(strategy.EntryConditions)
     indicators += extractIndicators(strategy.ExitConditions)
  
  3. 批量计算指标
     results := computeIndicators(klines, indicators)
  
  4. 条件树评估
     signal := evaluator.Evaluate(strategy.EntryConditions, results)
     // 组间 OR: 任一组全部满足 → 触发
     // 组内 AND: 组内所有条件同时满足 → 该组满足
  
  5. 信号类型
     signal = BUY  → 检查是否已有持仓 + 风控限制
     signal = SELL → 检查是否正确方向
     signal = HOLD → 记录日志，不执行
  
  6. 直接下单（自动执行）
     executor.Execute(signal, strategy)
```

### 5.3 自动下单执行器

```go
// strategy/executor.go

func (e *Executor) Execute(signal Signal, cfg StrategyConfig) error {
    // 1. 风控预检
    if err := e.riskCheck(cfg); err != nil {
        return err
    }
    
    // 2. 计算下单量（基于账户余额和风险比例）
    qty := e.calculatePositionSize(cfg)
    
    // 3. 执行下单
    result, err := e.trader.OpenLong(cfg.Symbol, qty, cfg.Risk.Leverage)
    if err != nil {
        return err
    }
    
    // 4. 设置止盈止损
    if tpPrice := e.calcTakeProfit(cfg, result.EntryPrice); tpPrice > 0 {
        e.trader.SetTakeProfit(cfg.Symbol, "LONG", qty, tpPrice)
    }
    if slPrice := e.calcStopLoss(cfg, result.EntryPrice); slPrice > 0 {
        e.trader.SetStopLoss(cfg.Symbol, "LONG", qty, slPrice)
    }
    
    // 5. 记录信号日志
    e.logSignal(signal, cfg, result)
    
    return nil
}
```

