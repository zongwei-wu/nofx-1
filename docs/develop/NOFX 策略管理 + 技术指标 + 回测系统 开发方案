    AvgWinPct             float64 `json:"avg_win_pct"`
    AvgLossPct            float64 `json:"avg_loss_pct"`
    MaxConsecutiveLosses  int     `json:"max_consecutive_losses"`
    TotalTrades           int     `json:"total_trades"`
}
```

