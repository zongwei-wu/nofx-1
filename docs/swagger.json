    },
    "PromptTemplateCreateRequest": {
      "type": "object",
      "required": ["name", "content"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "content": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "PromptTemplateUpdateRequest": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "HermesTradeRequest": {
      "type": "object",
      "required": ["exchange_id", "action", "symbol", "confirmed"],
      "properties": {
        "exchange_id": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["open_long", "open_short", "close_long", "close_short", "add_long", "add_short", "reduce_long", "reduce_short"]
        },
        "symbol": { "type": "string" },
        "quantity": { "type": "number" },
        "leverage": { "type": "integer" },
        "confirmed": { "type": "boolean" }
      }
    },
    "HermesSettingsUpdateRequest": {
      "type": "object",
      "properties": {
        "autonomous_enabled": { "type": "boolean", "description": "半自动授权，Runner 内部下单免 confirmed" },
        "exchange_id": { "type": "string" },
        "ai_model_id": { "type": "string" },
        "scan_interval_minutes": { "type": "integer" },
        "system_prompt_template": { "type": "string", "default": "hermes" },
        "btc_eth_leverage": { "type": "integer" },
        "altcoin_leverage": { "type": "integer" },
        "trading_coins": { "type": "array", "items": { "type": "string" } },
        "initial_balance": { "type": "number" }
      }
    },
    "HermesLeverageRequest": {
      "type": "object",
      "required": ["exchange_id", "symbol", "leverage"],
      "properties": {
        "exchange_id": { "type": "string" },
        "symbol": { "type": "string" },
        "leverage": { "type": "integer" }
      }
    },
    "HermesStopOrderRequest": {
      "type": "object",
      "required": ["exchange_id", "symbol", "position_side", "quantity", "stop_price"],
      "properties": {
        "exchange_id": { "type": "string" },
        "symbol": { "type": "string" },
        "position_side": { "type": "string", "enum": ["LONG", "SHORT"] },
        "quantity": { "type": "number" },
        "stop_price": { "type": "number" }
      }
    }
  }
}
