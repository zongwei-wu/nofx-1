{
  "swagger": "2.0",
  "info": {
    "title": "NOFX API",
    "version": "1.0.0",
    "description": "NOFX trading platform API"
  },
  "basePath": "/api",
  "schemes": ["http", "https"],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer token, e.g. Bearer {token}"
    }
  },
  "paths": {
    "/prompt-templates": {
      "get": {
        "tags": ["PromptTemplates"],
        "summary": "获取系统提示词模板列表",
        "description": "返回所有可用模板名称（无需认证，数据来自数据库缓存）",
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/PromptTemplatesListResponse" }
          }
        }
      }
    },
    "/prompt-templates/{name}": {
      "get": {
        "tags": ["PromptTemplates"],
        "summary": "获取指定提示词模板内容",
        "description": "返回模板完整内容（无需认证）",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "type": "string", "description": "模板名称" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/PromptTemplateDetailResponse" }
          },
          "404": { "description": "模板不存在" }
        }
      }
    },
    "/trade-events": {
      "get": {
        "tags": ["TradeEvents"],
        "summary": "统一交易事件",
        "description": "按数据源返回开/加/减/平事件，供 K 线标注图使用。ai_trader=AI 本账户成交；ai_copy_trade=指定 AI 交易员参与的跟单成交；copy_trade=跟单 DB 记录（默认不含带单员推断，不含 exchange 持仓同步记录）；include_lead=1 时追加带单员订单推断事件（source=lead）",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": true,
            "type": "string",
            "enum": ["ai_trader", "ai_copy_trade", "copy_trade"],
            "description": "事件数据源"
          },
          {
            "name": "trader_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "AI 交易员 ID（ai_trader / ai_copy_trade 必填）"
          },
          {
            "name": "portfolio_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "带单组合 ID（copy_trade 可选筛选）"
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "币种，如 BTCUSDT"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64",
            "description": "起始时间（毫秒时间戳）"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64",
            "description": "结束时间（毫秒时间戳）"
          },
          {
            "name": "include_lead",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["1"],
            "description": "copy_trade 时设为 1 可追加带单员订单推断事件（source=lead）"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/TradeEventsResponse"
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未登录"
          },
          "404": {
            "description": "交易员不存在"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "当前用户信息与功能权限",
        "description": "返回用户套餐 plan 及可用 features 列表，供前台菜单权限控制",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/MeResponse" }
          },
          "401": { "description": "未登录" }
        }
      }
    },
    "/admin/me": {
      "get": {
        "tags": ["Admin"],
        "summary": "当前管理员信息",
        "description": "返回已登录管理员的基本信息，需 admin 角色",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/AdminMeResponse"
            }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/plans": {
      "get": {
        "tags": ["Admin"],
        "summary": "套餐列表",
        "description": "返回全部套餐及其绑定的 feature_key 列表",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminPlansResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin"],
        "summary": "分页查询用户列表",
        "description": "跨用户查询，不返回密码与 OTP 密钥",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "current", "in": "query", "type": "integer", "description": "当前页码（ProTable）" },
          { "name": "page", "in": "query", "type": "integer", "description": "当前页码（兼容）" },
          { "name": "pageSize", "in": "query", "type": "integer", "description": "每页条数" },
          { "name": "email", "in": "query", "type": "string", "description": "邮箱模糊搜索" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminUsersPageResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/users/{id}": {
      "put": {
        "tags": ["Admin"],
        "summary": "更新用户套餐",
        "description": "为用户分配套餐 plan，立即影响功能权限",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "用户 ID" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AdminUpdateUserRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": { "$ref": "#/definitions/AdminUpdateUserResponse" }
          },
          "400": { "description": "参数错误或套餐不存在" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "用户不存在" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "删除用户或管理员",
        "description": "不能删除自己或最后一个管理员",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "用户 ID" }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "schema": { "$ref": "#/definitions/AdminSuccessMessageResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员或违反安全规则" },
          "404": { "description": "用户不存在" }
        }
      }
    },
    "/admin/users/{id}/role": {
      "put": {
        "tags": ["Admin"],
        "summary": "提权或降权用户",
        "description": "将用户 role 设为 admin 或 user；不能降权自己或最后一个管理员",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "用户 ID" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AdminUpdateUserRoleRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": { "$ref": "#/definitions/AdminSuccessMessageResponse" }
          },
          "400": { "description": "参数错误" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员或违反安全规则" },
          "404": { "description": "用户不存在" }
        }
      }
    },
    "/admin/users/{id}/password": {
      "put": {
        "tags": ["Admin"],
        "summary": "管理员重置用户密码",
        "description": "无需 OTP，直接重置指定用户密码",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "用户 ID" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AdminResetPasswordRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "重置成功",
            "schema": { "$ref": "#/definitions/AdminSuccessMessageResponse" }
          },
          "400": { "description": "参数错误" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "用户不存在" }
        }
      }
    },
    "/admin/admins": {
      "get": {
        "tags": ["Admin"],
        "summary": "分页查询管理员列表",
        "description": "仅返回 role=admin 的用户",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "current", "in": "query", "type": "integer", "description": "当前页码（ProTable）" },
          { "name": "page", "in": "query", "type": "integer", "description": "当前页码（兼容）" },
          { "name": "pageSize", "in": "query", "type": "integer", "description": "每页条数" },
          { "name": "email", "in": "query", "type": "string", "description": "邮箱模糊搜索" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminUsersPageResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "创建管理员",
        "description": "新建管理员账号，跳过 OTP，plan 设为 vip",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AdminCreateAdminRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "创建成功",
            "schema": { "$ref": "#/definitions/AdminCreateAdminResponse" }
          },
          "400": { "description": "参数错误或邮箱已存在" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/traders": {
      "get": {
        "tags": ["Admin"],
        "summary": "分页查询 AI 交易员",
        "description": "跨用户查询，合并内存实时运行状态",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "current", "in": "query", "type": "integer" },
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "pageSize", "in": "query", "type": "integer" },
          { "name": "user_id", "in": "query", "type": "string", "description": "用户 ID 筛选" },
          { "name": "email", "in": "query", "type": "string", "description": "用户邮箱模糊搜索" },
          { "name": "name", "in": "query", "type": "string", "description": "交易员名称模糊搜索" },
          { "name": "is_running", "in": "query", "type": "string", "description": "true/false 运行状态筛选" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminTradersPageResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/traders/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "AI 交易员详情",
        "description": "返回配置与模型/交易所名称，不含密钥",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "交易员 ID" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminTraderDetailResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "交易员不存在" }
        }
      }
    },
    "/admin/traders/{id}/account": {
      "get": {
        "tags": ["Admin"],
        "summary": "AI 交易员账户信息（只读）",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "交易员 ID" }
        ],
        "responses": {
          "200": { "description": "成功" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "交易员不存在或未加载" }
        }
      }
    },
    "/admin/traders/{id}/positions": {
      "get": {
        "tags": ["Admin"],
        "summary": "AI 交易员持仓（只读）",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "交易员 ID" }
        ],
        "responses": {
          "200": { "description": "成功" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "交易员不存在或未加载" }
        }
      }
    },
    "/admin/traders/{id}/stop": {
      "post": {
        "tags": ["Admin"],
        "summary": "强制停止 AI 交易员",
        "description": "管理员强制停止运行中的交易员",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "交易员 ID" }
        ],
        "responses": {
          "200": {
            "description": "停止成功",
            "schema": { "$ref": "#/definitions/AdminSuccessMessageResponse" }
          },
          "400": { "description": "交易员已停止" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "交易员不存在或未加载" }
        }
      }
    },
    "/admin/copy-trade/records": {
      "get": {
        "tags": ["Admin"],
        "summary": "分页查询跟单记录",
        "description": "跨用户查询 copy_trade_records",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "current", "in": "query", "type": "integer" },
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "pageSize", "in": "query", "type": "integer" },
          { "name": "user_id", "in": "query", "type": "string", "description": "用户 ID 筛选" },
          { "name": "status", "in": "query", "type": "string", "description": "状态筛选 OPEN/CLOSED/FAILED" },
          { "name": "symbol", "in": "query", "type": "string", "description": "交易对模糊搜索" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminCopyTradeRecordsPageResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/system-config": {
      "get": {
        "tags": ["Admin"],
        "summary": "获取系统配置",
        "description": "返回运营相关系统配置项",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminSystemConfigResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      },
      "put": {
        "tags": ["Admin"],
        "summary": "更新系统配置",
        "description": "白名单 key 更新，如 registration_enabled、beta_mode 等",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AdminSystemConfigUpdateRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "保存成功",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "message": { "type": "string" }
              }
            }
          },
          "400": { "description": "参数错误或不允许的配置项" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/prompt-templates": {
      "get": {
        "tags": ["Admin"],
        "summary": "分页查询提示词模板",
        "description": "管理员查询系统提示词模板列表",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "current", "in": "query", "type": "integer" },
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "pageSize", "in": "query", "type": "integer" },
          { "name": "name", "in": "query", "type": "string", "description": "模板名称模糊搜索" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminPromptTemplatesPageResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "创建提示词模板",
        "description": "名称创建后不可修改",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/PromptTemplateCreateRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "创建成功",
            "schema": { "$ref": "#/definitions/AdminSuccessMessageResponse" }
          },
          "400": { "description": "参数错误或名称已存在" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" }
        }
      }
    },
    "/admin/prompt-templates/{name}": {
      "get": {
        "tags": ["Admin"],
        "summary": "获取提示词模板详情",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "name", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": { "$ref": "#/definitions/AdminPromptTemplateDetailResponse" }
          },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "模板不存在" }
        }
      },
      "put": {
        "tags": ["Admin"],
        "summary": "更新提示词模板",
        "description": "仅可更新内容与描述，不可改名",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "name", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/PromptTemplateUpdateRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": { "$ref": "#/definitions/AdminSuccessMessageResponse" }
          },
          "400": { "description": "参数错误" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "模板不存在" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "删除提示词模板",
        "description": "有交易员引用时拒绝删除",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "name", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "schema": { "$ref": "#/definitions/AdminSuccessMessageResponse" }
          },
          "400": { "description": "模板正在被交易员使用" },
          "401": { "description": "未登录" },
          "403": { "description": "非管理员" },
          "404": { "description": "模板不存在" }
        }
      }
    },
    "/copy-trade/settings": {
      "get": {
        "tags": ["CopyTrade"],
        "summary": "获取跟单全局设置",
        "description": "返回用户为跟单开单 AI 分析所选的全局 AI 交易员配置",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/CopyTradeSettingsResponse"
            }
          },
          "500": {
            "description": "服务器错误"
          }
        }
      },
      "put": {
        "tags": ["CopyTrade"],
        "summary": "更新跟单全局设置",
