  "definitions": {
    "EncryptedPayload": {
      "type": "object",
      "required": ["wrappedKey", "iv", "ciphertext"],
      "properties": {
        "wrappedKey": { "type": "string", "description": "RSA-OAEP 加密的 AES 密钥" },
        "iv": { "type": "string", "description": "AES-GCM IV" },
        "ciphertext": { "type": "string", "description": "AES-GCM 密文（含 tag）" },
        "aad": { "type": "string" },
        "kid": { "type": "string" },
        "ts": { "type": "integer", "format": "int64" }
      }
    },
    "TestExchangeConnectionRequest": {
      "type": "object",
      "required": ["exchange_id"],
      "description": "加密载荷解密后的明文 JSON 结构",
      "properties": {
        "exchange_id": { "type": "string", "enum": ["binance", "hyperliquid", "aster", "okx"] },
        "api_key": { "type": "string", "description": "为空时从用户已保存配置补全" },
        "secret_key": { "type": "string", "description": "为空时从用户已保存配置补全" },
        "testnet": { "type": "boolean", "description": "始终以表单值为准" },
        "hyperliquid_wallet_addr": { "type": "string" },
        "aster_user": { "type": "string" },
        "aster_signer": { "type": "string" },
        "aster_private_key": { "type": "string", "description": "为空时从用户已保存配置补全" },
        "passphrase": { "type": "string", "description": "OKX Passphrase，为空时从用户已保存配置补全" }
      }
    },
    "TestExchangeConnectionResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "exchange_id": { "type": "string" },
        "testnet": { "type": "boolean" },
        "total_equity": { "type": "number", "format": "double" },
        "available_balance": { "type": "number", "format": "double" },
        "message": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "TradeEvent": {
