{
  "swagger": "2.0",
  "info": {
    "title": "NOFX API",
    "version": "1.0.0",
    "description": "NOFX trading platform API"
  },
  "basePath": "/api",
  "schemes": ["http", "https"],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer token, e.g. Bearer {token}"
    }
  },
  "paths": {
    "/trade-events": {
      "get": {
        "tags": ["TradeEvents"],
        "summary": "统一交易事件",
        "description": "按数据源返回开/加/减/平事件，供 K 线标注图使用。ai_trader=AI 本账户成交；ai_copy_trade=指定 AI 交易员参与的跟单成交；copy_trade=跟单管理全量（含带单员订单推断）",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": true,
            "type": "string",
            "enum": ["ai_trader", "ai_copy_trade", "copy_trade"],
            "description": "事件数据源"
          },
          {
            "name": "trader_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "AI 交易员 ID（ai_trader / ai_copy_trade 必填）"
          },
          {
            "name": "portfolio_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "带单组合 ID（copy_trade 可选筛选）"
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "币种，如 BTCUSDT"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64",
            "description": "起始时间（毫秒时间戳）"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64",
            "description": "结束时间（毫秒时间戳）"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/TradeEventsResponse"
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未登录"
          },
          "404": {
            "description": "交易员不存在"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/copy-trade/settings": {
      "get": {
        "tags": ["CopyTrade"],
        "summary": "获取跟单全局设置",
        "description": "返回用户为跟单开单 AI 分析所选的全局 AI 交易员配置",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "$ref": "#/definitions/CopyTradeSettingsResponse"
            }
          },
          "500": {
            "description": "服务器错误"
          }
        }
      },
      "put": {
        "tags": ["CopyTrade"],
        "summary": "更新跟单全局设置",
        "description": "设置用于跟单开单 AI 分析的全局 AI 交易员；传空字符串表示清除选择并回退默认模型",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateCopyTradeSettingsRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "保存成功",
            "schema": {
              "type": "object",
              "properties": {
                "message": { "type": "string" },
                "ai_trader_id": { "type": "string" }
              }
            }
          },
          "400": {
            "description": "参数错误或 AI 交易员不存在"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    }
  },
  "definitions": {
    "TradeEvent": {
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "time": { "type": "integer", "format": "int64", "description": "毫秒时间戳" },
        "type": { "type": "string", "enum": ["open", "add", "reduce", "close"] },
        "side": { "type": "string", "description": "LONG 或 SHORT" },
        "qty": { "type": "number", "format": "double" },
        "price": { "type": "number", "format": "double" },
        "source": { "type": "string", "description": "ai_trader | ai_copy_trade | copy_trade | lead" },
        "detail": { "type": "string" }
      }
    },
    "TradeEventsResponse": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/TradeEvent" }
        },
        "symbols": {
          "type": "array",
          "items": { "type": "string" },
          "description": "可用币种列表"
        }
      }
    },
    "UpdateCopyTradeSettingsRequest": {
      "type": "object",
      "required": ["ai_trader_id"],
      "properties": {
        "ai_trader_id": {
          "type": "string",
          "description": "AI 交易员 ID，空字符串表示未选择"
        }
      }
    },
    "CopyTradeSettingsResponse": {
      "type": "object",
      "properties": {
        "ai_trader_id": {
          "type": "string",
          "description": "已选择的 AI 交易员 ID"
        },
        "ai_trader_name": {
          "type": "string",
          "description": "已选择的 AI 交易员名称"
        },
        "ai_model_name": {
          "type": "string",
          "description": "关联 AI 模型名称"
        },
        "fallback_used": {
          "type": "boolean",
          "description": "未选择交易员时是否回退到默认已启用模型"
        }
      }
    }
  }
}
